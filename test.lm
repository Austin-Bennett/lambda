extern fn malloc(n_bytes: usize) = uint8*;
extern fn free(ptr: uint8*);
extern fn realloc(ptr: uint8*, n_bytes: usize) = uint8*;

struct IntList {
    array: int32*,
    //the actual array size
    size: usize,
    //the length of the array
    length: usize,
}

modify int32 {
    public fn max(self, other: int32) = int32 {
        if other > *self {
            return other;
        } else {
            return *self;
        }
    }
}

modify IntList {
    public fn new() = IntList {
        return IntList(malloc(4) as int32*, 1, 0);
    }

    public fn with_capacity(cap: usize) = IntList {
        return IntList(malloc(cap * 4) as int32*, cap, 0);
    }


    public fn get(self, ind: usize) = int32& {
        return *(*self.array + ind as isize);
    }

    public fn add(self, v: int32) {
        if *self.length >= *self.size {
            new_size: usize = (*self.length * 2) + 1;
            self.array = realloc((*self.array) as uint8*, new_size * 4) as int32*;
            self.size = new_size;
        }
        **(self.array + self.length as isize) = v;
        self.length = *self.length + 1;
    }

    public fn drop(self) {
        free(self.array as uint8*);
        self.length = 0;
        self.size = 0;
        self.array = 0 as int32*;
    }
}


fn main() = int8 {
    list: IntList = IntList.with_capacity(30);
    list.add(10);
    list.add(20);
    list.add(30);
    list.add(40);

    res: int32 = *list.get(2);

    list.drop();

    return res as int8;
}
