


fn fib(n: int32) = int32 {
    if n <= 1 {
        return 1;
    } else {
        return fib(n - 1) + fib(n-2);
    }
}

fn count(n: int8) = int8 {
    i: int8 = 0;

    while i < n {
        i = i + 1;
    }
    return i;
}

//main function- this is where code starts executing
fn main() = int8 {

    return count(5);

}