
struct Point {
    public x: int32,
    public y: int32,
}

modify Point {
    public sum(self) = int32 {
        return self.x + self.y;
    }

    public length2(self) = int32 {
        return self.x * self.x + self.y * self.y;
    }
}

modify int32 {
    public max(self, other: int32) = int32 {
        if self > other {
            return self;
        }
        return other;
    }
}

fn main() = int8 {
    p: Point = Point(3, 4);
    s: int32 = p.sum();
    s2: int32 = p.length2();

    a: int32 = 10;
    b: int32 = a.max(s);

    return s2 as int8;
}
