; ModuleID = 'lambda_program'
source_filename = "lambda_program"

define i32 @add(i32 %0, i32 %1) {
entry:
  %a = alloca i32, align 4
  store i32 %0, ptr %a, align 4
  %b = alloca i32, align 4
  store i32 %1, ptr %b, align 4
  %a1 = load i32, ptr %a, align 4
  %b2 = load i32, ptr %b, align 4
  %iadd = add i32 %a1, %b2
  ret i32 %iadd
}

declare ptr @malloc(i64)

declare void @free(ptr)

define i32 @sub(i32 %0, i32 %1) {
entry:
  %a = alloca i32, align 4
  store i32 %0, ptr %a, align 4
  %b = alloca i32, align 4
  store i32 %1, ptr %b, align 4
  %a1 = load i32, ptr %a, align 4
  %b2 = load i32, ptr %b, align 4
  %isub = sub i32 %a1, %b2
  ret i32 %isub
}

define i8 @main() {
entry:
  %a = alloca ptr, align 8
  %call = call ptr @malloc(i64 1)
  store ptr %call, ptr %a, align 8
  %a_ref = alloca ptr, align 8
  %a1 = load ptr, ptr %a, align 8
  store ptr %a1, ptr %a_ref, align 8
  %a_ref2 = load ptr, ptr %a_ref, align 8
  store i8 30, ptr %a_ref2, align 1
  %a_ref3 = load ptr, ptr %a_ref, align 8
  %refread = load i8, ptr %a_ref3, align 1
  %idiv = sdiv i8 %refread, 2
  %imul = mul i8 3, %idiv
  %a_ref4 = load ptr, ptr %a_ref, align 8
  store i8 %imul, ptr %a_ref4, align 1
  %a_ref5 = load ptr, ptr %a_ref, align 8
  %refread6 = load i8, ptr %a_ref5, align 1
  ret i8 %refread6
}
