; ModuleID = 'lambda_program'
source_filename = "lambda_program"

define i32 @fib(i32 %0) {
entry:
  %n = alloca i32, align 4
  store i32 %0, ptr %n, align 4
  %n1 = load i32, ptr %n, align 4
  %ile = icmp sle i32 %n1, 1
  br i1 %ile, label %then, label %else

then:                                             ; preds = %entry
  ret i32 1

else:                                             ; preds = %entry
  %n2 = load i32, ptr %n, align 4
  %isub = sub i32 %n2, 1
  %call = call i32 @fib(i32 %isub)
  %n3 = load i32, ptr %n, align 4
  %isub4 = sub i32 %n3, 2
  %call5 = call i32 @fib(i32 %isub4)
  %iadd = add i32 %call, %call5
  ret i32 %iadd

if_merge:                                         ; No predecessors!
  unreachable
}

define i8 @count(i8 %0) {
entry:
  %n = alloca i8, align 1
  store i8 %0, ptr %n, align 1
  %i = alloca i8, align 1
  store i8 0, ptr %i, align 1
  %i1 = load i8, ptr %i, align 1
  %n2 = load i8, ptr %n, align 1
  %ilt = icmp slt i8 %i1, %n2
  br i1 %ilt, label %loop, label %loop_end
  %i3 = load i8, ptr %i, align 1
  %iadd = add i8 %i3, 1
  store i8 %iadd, ptr %i, align 1
  br label %loop_start

loop_start:                                       ; preds = %entry

loop:                                             ; preds = %entry

loop_end:                                         ; preds = %entry
  %i4 = load i8, ptr %i, align 1
  ret i8 %i4
}

define i8 @main() {
entry:
  %call = call i8 @count(i8 5)
  ret i8 %call
}
