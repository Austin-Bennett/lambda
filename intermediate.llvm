source_filename = "lambda_program"

define i32 @Point_sum(ptr %0) {
entry:
  %self = alloca ptr, align 8
  store ptr %0, ptr %self, align 8
  %self1 = load ptr, ptr %self, align 8
  %deref_struct = load { i32, i32 }, ptr %self1, align 4
  %member = extractvalue { i32, i32 } %deref_struct, 0
  %self2 = load ptr, ptr %self, align 8
  %deref_struct3 = load { i32, i32 }, ptr %self2, align 4
  %member4 = extractvalue { i32, i32 } %deref_struct3, 1
  %iadd = add i32 %member, %member4
  ret i32 %iadd
}

define i32 @Point_length2(ptr %0) {
entry:
  %self = alloca ptr, align 8
  store ptr %0, ptr %self, align 8
  %self1 = load ptr, ptr %self, align 8
  %deref_struct = load { i32, i32 }, ptr %self1, align 4
  %member = extractvalue { i32, i32 } %deref_struct, 0
  %self2 = load ptr, ptr %self, align 8
  %deref_struct3 = load { i32, i32 }, ptr %self2, align 4
  %member4 = extractvalue { i32, i32 } %deref_struct3, 0
  %imul = mul i32 %member, %member4
  %self5 = load ptr, ptr %self, align 8
  %deref_struct6 = load { i32, i32 }, ptr %self5, align 4
  %member7 = extractvalue { i32, i32 } %deref_struct6, 1
  %self8 = load ptr, ptr %self, align 8
  %deref_struct9 = load { i32, i32 }, ptr %self8, align 4
  %member10 = extractvalue { i32, i32 } %deref_struct9, 1
  %imul11 = mul i32 %member7, %member10
  %iadd = add i32 %imul, %imul11
  ret i32 %iadd
}

define i32 @int32_max(ptr %0, i32 %1) {
entry:
  %self = alloca ptr, align 8
  store ptr %0, ptr %self, align 8
  %other = alloca i32, align 4
  store i32 %1, ptr %other, align 4
  %self1 = load ptr, ptr %self, align 8
  %refread = load i32, ptr %self1, align 4
  %other2 = load i32, ptr %other, align 4
  %igt = icmp sgt i32 %refread, %other2
  br i1 %igt, label %then, label %else

then:                                             ; preds = %entry
  %self3 = load ptr, ptr %self, align 8
  %refread4 = load i32, ptr %self3, align 4
  ret i32 %refread4

else:                                             ; preds = %entry
  br label %if_merge

if_merge:                                         ; preds = %else
  %other5 = load i32, ptr %other, align 4
  ret i32 %other5
}

define i8 @main() {
entry:
  %p = alloca { i32, i32 }, align 8
  store { i32, i32 } { i32 3, i32 4 }, ptr %p, align 4
  %s = alloca i32, align 4
  %call = call i32 @Point_sum(ptr %p)
  store i32 %call, ptr %s, align 4
  %s2 = alloca i32, align 4
  %call1 = call i32 @Point_length2(ptr %p)
  store i32 %call1, ptr %s2, align 4
  %a = alloca i32, align 4
  store i32 10, ptr %a, align 4
  %b = alloca i32, align 4
  %s3 = load i32, ptr %s, align 4
  %call4 = call i32 @int32_max(ptr %a, i32 %s3)
  store i32 %call4, ptr %b, align 4
  %s25 = load i32, ptr %s2, align 4
  %trunc = trunc i32 %s25 to i8
  ret i8 %trunc
}
