use std::list
use raylib



struct Paddle {
    collision: Rect,
}

modify Paddle {
    public fn new(x: float32, y: float32) = Paddle {
        return Paddle(Rect(x, y, 20.0, 100.0));
    }

    public fn draw(self&) {
        DrawRectangleRec(self.collision, Color(255, 255, 255, 255));
    }
}

struct Ball {
    collision: Rect,
    vel: FVec2,
}

modify Ball {
    public fn new() = Ball {
        //center the ball on screen
        return Ball(Rect(395.0, 295.0, 10.0, 10.0), FVec2(-10.0, 0.0));
    }

    public fn draw(self&) {
        DrawCirc(self.collision.center_x() as int32, self.collision.center_y() as int32, 5.0, Color(255, 255, 255, 255));
    }

    public fn update(self&, lpaddle: Paddle&, rpaddle: Paddle&) {

    }
}



fn main() = int8 {

    InitWindow(800, 600, c"Lambda PONG");
    let constants = RayConstants.new();

    let r = Rect(200.0, 200.0, 100.0, 100.0);
    let mrect = Rect(0.0, 0.0, 20.0, 20.0);

    let lpaddle = Paddle.new(20.0, 20.0);
    let rpaddle = Paddle.new(760.0, 20.0);
    let ball = Ball.new();

    while !WindowShouldClose() {
        BeginDrawing();

        ClearBackground(constants.black);

        lpaddle.draw();
        rpaddle.draw();

        ball.draw();

        ball.update(&lpaddle, &rpaddle);

        DrawText(c"Hello, LAMBDA", 20, 20, 20, constants.gold);

        EndDrawing();
    }

    CloseWindow();

    return mrect.y as int8;
}
