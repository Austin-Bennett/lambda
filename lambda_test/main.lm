
extern fn cprint(s: str);

// ---- generic functions ----

fn<T> identity(x: T) = T {
    return x;
}

fn<T> max(a: T, b: T) = T {
    if a > b {
        return a;
    }
    return b;
}

fn<T> min(a: T, b: T) = T {
    if a < b {
        return a;
    }
    return b;
}

// generic calling another generic — instantiation chain
fn<T> double_identity(x: T) = T {
    return identity.<T>(x);
}

// ---- generic struct with methods ----

struct<T> Pair {
    a: T,
    b: T,
}

modify<T> Pair<T> {
    public fn sum(self) = T {
        return self.a + self.b;
    }
    public fn first(self) = T {
        return self.a;
    }
    public fn second(self) = T {
        return self.b;
    }
    public fn swap(self) {
        let tmp = self.a;
        self.a = self.b;
        self.b = tmp;
    }
}

// ---- plain struct with operator overloading ----

struct Vec2 {
    x: float32,
    y: float32,
}

modify Vec2 {
    fn operator add(self, rhs: Vec2) = Vec2 {
        r: Vec2;
        r.x = self.x + rhs.x;
        r.y = self.y + rhs.y;
        return r;
    }
    fn operator sub(self, rhs: Vec2) = Vec2 {
        r: Vec2;
        r.x = self.x - rhs.x;
        r.y = self.y - rhs.y;
        return r;
    }
    // cmp: lexicographic by x then y; returns int8 negative/zero/positive
    fn operator cmp(self, rhs: Vec2) = int8 {
        if self.x < rhs.x { return -1; }
        if self.x > rhs.x { return 1; }
        if self.y < rhs.y { return -1; }
        if self.y > rhs.y { return 1; }
        return 0;
    }
}

// ---- struct with self-mutation via reference ----

struct Counter {
    n: int32,
}

modify Counter {
    public fn tick(self) {
        self.n = self.n + 1;
    }
    public fn add_n(self, k: int32) {
        self.n = self.n + k;
    }
    public fn value(self) = int32 {
        return self.n;
    }
    public fn reset(self) {
        self.n = 0;
    }
}

// ---- iterative arithmetic functions ----

fn factorial(n: int32) = int32 {
    r: int32 = 1;
    i: int32 = 2;
    while i <= n {
        r = r * i;
        i = i + 1;
    }
    return r;
}

fn fib(n: int32) = int32 {
    if n <= 1 { return n; }
    a: int32 = 0;
    b: int32 = 1;
    i: int32 = 2;
    while i <= n {
        let t = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    return b;
}

fn sum_to(n: int32) = int32 {
    total: int32 = 0;
    i: int32 = 1;
    while i <= n {
        total += i;
        i += 1;
    }
    return total;
}

fn abs(x: int32) = int32 {
    if x < 0 { return -x; }
    return x;
}

fn gcd(a: int32, b: int32) = int32 {
    while b != 0 {
        let t = b;
        b = a - (a / b) * b;
        a = t;
    }
    return abs(a);
}

fn main() = int8 {

    cprint("=== identity across types ===\n");
    let i_i32  = identity.<int32>(42);
    let i_i64  = identity.<int64>(9999999999);
    let i_u32  = identity.<uint32>(4294967295);
    let i_f32  = identity.<float32>(3.14);
    let i_f64  = identity.<float64>(2.718281828);
    let i_bool = identity.<bool>(true);

    cprint("=== double_identity (generic -> generic chain) ===\n");
    let di_i32  = double_identity.<int32>(99);
    let di_i64  = double_identity.<int64>(1234567890);
    let di_bool = double_identity.<bool>(false);

    cprint("=== max / min across numeric types ===\n");
    let mx_i32 = max.<int32>(10, 20);
    let mn_i32 = min.<int32>(10, 20);
    let mx_i64 = max.<int64>(100, 50);
    let mx_u8  = max.<uint8>(200, 100);
    let mx_f32 = max.<float32>(1.5, 2.5);
    let mx_f64 = max.<float64>(3.14, 2.72);
    let mn_f64 = min.<float64>(3.14, 2.72);

    cprint("=== Pair<int32> methods ===\n");
    p: Pair<int32>;
    p.a = 7;
    p.b = 13;
    let p_sum   = p.sum();     // 20
    let p_first = p.first();   // 7
    p.swap();
    let p_after = p.first();   // 13 (was second)

    cprint("=== Pair<float32> methods ===\n");
    fp: Pair<float32>;
    fp.a = 1.5;
    fp.b = 2.5;
    let fp_sum = fp.sum();     // 4.0

    cprint("=== Pair<int64> (third instantiation) ===\n");
    lp: Pair<int64>;
    lp.a = 1000000000;
    lp.b = 2000000000;
    let lp_sum = lp.sum();     // 3000000000

    cprint("=== Vec2 operator overloading ===\n");
    va: Vec2;
    va.x = 1.0;
    va.y = 2.0;
    vb: Vec2;
    vb.x = 3.0;
    vb.y = 4.0;
    let vc = va + vb;          // (4.0, 6.0)
    let vd = vb - va;          // (2.0, 2.0)
    let eq_aa  = va == va;     // true
    let eq_ab  = va == vb;     // false
    let lt_ab  = va < vb;      // true
    let gt_ba  = vb > va;      // true
    let ne_ab  = va != vb;     // true
    let le_aa  = va <= va;     // true

    cprint("=== Vec2 chained: result of op used in further op ===\n");
    let vsum  = vc + vd;       // (6.0, 8.0)
    let vdiff = vc - vd;       // (2.0, 4.0)

    cprint("=== Counter self-mutation ===\n");
    ct: Counter;
    ct.n = 0;
    ct.tick();
    ct.tick();
    ct.tick();
    let cv1 = ct.value();      // 3
    ct.add_n(7);
    let cv2 = ct.value();      // 10
    ct.reset();
    let cv3 = ct.value();      // 0

    cprint("=== factorial / fib / sum_to ===\n");
    let f0   = factorial(0);   // 1 (empty loop)
    let f1   = factorial(1);   // 1
    let f5   = factorial(5);   // 120
    let fib0 = fib(0);         // 0
    let fib1 = fib(1);         // 1
    let fib10 = fib(10);       // 55
    let s10  = sum_to(10);     // 55

    cprint("=== gcd ===\n");
    let g1 = gcd(48, 18);      // 6
    let g2 = gcd(100, 75);     // 25
    let g3 = gcd(7, 13);       // 1
    let g4 = gcd(42, 0);       // 42 (b=0, loop skipped)

    cprint("=== casts ===\n");
    big: int64 = 300;
    let to_i32 = big as int32;   // 300
    let to_i8  = big as int8;    // 44  (300 - 256)
    fl: float32 = 7.9;
    let to_int = fl as int32;    // 7 (truncate)
    // sign reinterpret: uint8(255) -> int8(-1)
    u255: uint8 = 255;
    let s_neg1 = u255 as int8;    // -1
    // int -> float64 -> int round-trip
    orig: int32 = 42;
    let as_f = orig as float64;
    let back   = as_f as int32;  // 42

    cprint("=== compound arithmetic assigns ===\n");
    x: int32 = 10;
    x += 5;    // 15
    x -= 3;    // 12
    x *= 2;    // 24
    x /= 4;    // 6

    cprint("=== compound bitwise assigns ===\n");
    bx: int32 = 255;
    bx &= 15;  // 15
    bx |= 48;  // 63
    bx ^= 15;  // 48
    bx <<= 2;  // 192
    bx >>= 1;  // 96

    cprint("=== boolean short-circuit and assigns ===\n");
    bt: bool = true;
    bf: bool = false;
    let and_r = bt && bf;   // false
    let or_r  = bt || bf;   // true
    bt &&= bf;              // bt = false
    bt ||= true;            // bt = true

    cprint("=== unary operators ===\n");
    pos: int32 = 42;
    let neg_val = -pos;     // -42
    zero: int32 = 0;
    let all_ones = !zero;   // -1 (bitwise NOT)
    nbool: bool = true;
    let not_true = !nbool;  // false

    cprint("=== nested: identity(max(...)) ===\n");
    let nested = identity.<int32>(max.<int32>(5, 8));    // 8

    cprint("=== weird: function results as generic args ===\n");
    let weird1 = max.<int32>(factorial(3), fib(7));      // max(6,13)=13
    let weird2 = min.<int32>(sum_to(5), factorial(4));   // min(15,24)=15

    cprint("=== weird: Pair sum through identity ===\n");
    p2: Pair<int32>;
    p2.a = 100;
    p2.b = 100;
    let p2sum = identity.<int32>(p2.sum());              // 200

    cprint("=== weird: factorial overflow into int8 ===\n");
    let f10     = factorial(10);   // 3628800
    let f10_i8  = f10 as int8;     // 3628800 mod 256 = 0 -> 0 as int8

    cprint("=== weird: negative fib edge (n <= 1) ===\n");
    let fib_neg = fib(-1);         // -1 (n <= 1 holds, returns n)

    cprint("=== weird: many instantiations of max ===\n");
    let r_u8  = max.<uint8>(10, 20);
    let r_u16 = max.<uint16>(100, 200);
    let r_u32 = max.<uint32>(1000, 2000);
    let r_i8  = max.<int8>(10, 20);
    let r_f32 = max.<float32>(1.5, 2.5);
    let r_f64 = max.<float64>(1.5, 2.5);

    cprint("all done!\n");

    // return 0 on success: f5==120 and fib10==55
    let check = (f5 - 120) + (fib10 - 55);
    return check as int8;
}
