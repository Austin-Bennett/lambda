struct RayConstants {
    public lightgray: Color,
    public gray: Color,
    public darkgrey: Color,
    public yellow: Color,
    public gold: Color,
    public orange: Color,
    public pink: Color,
    public red: Color,
    public maroon: Color,
    public green: Color,
    public lime: Color,
    public darkgreen: Color,
    public skyblue: Color,
    public blue: Color,
    public darkblue: Color,
    public purple: Color,
    public violet: Color,
    public darkpurple: Color,
    public beige: Color,
    public brown: Color,
    public darkbrown: Color,
    public white: Color,
    public black: Color,
    public blank: Color,
    public magenta: Color,
    public raywhite: Color,
}

modify RayConstants {
    public fn new() = RayConstants {
        return RayConstants(
            Color(200, 200, 200, 255),  //lightgray
            Color(130, 130, 130, 255),  //gray
            Color(80, 80, 80, 255),     //dark gray
            Color(253, 249, 0, 255),    //yellow
            Color(255, 203, 0, 255),    //gold
            Color(255, 161, 0, 255),    //orange
            Color(255, 109, 194, 255),  //pink
            Color(230, 41, 55, 255),    //red
            Color(190, 33, 55, 255),    //maroon
            Color(0, 228, 48, 255),     //green
            Color(0, 158, 47, 255),     //lime
            Color(0, 117, 44, 255),     //dark green
            Color(102, 191, 255, 255),  //sky blue
            Color(0, 121, 241, 255),    //blue
            Color(0, 82, 172, 255),     //darkblue
            Color(200, 122, 255, 255),  //purple
            Color(135, 60, 190, 255),   //violet
            Color(112, 31, 126, 255),   //darkpurple
            Color(211, 176, 131, 255),  //beige
            Color(127, 106, 79, 255),   //brown
            Color(76, 63, 47, 255),     //dark brown
            Color(255, 255, 255, 255),  //white
            Color(0, 0, 0, 255),        //black
            Color(0, 0, 0, 0),          //blank
            Color(255, 0, 255, 255),    //magenta
            Color(245, 245, 245, 255),  //raywhite
        );
    }
}

struct FVec2 {
    public x: float32,
    public y: float32,
}

struct Rect {
   public x: float32,
   public y: float32,
   public w: float32,
   public h: float32,
}

modify Rect {
    public fn collides(self, r: Rect) = bool {
        return self.x < r.x + r.w &&
            self.x + self.w > r.x &&
            self.y < r.y + r.h    &&
            self.y + self.h > r.y
        ;
    }

    public fn center_x(self) = float32 {
        return self.x + self.w / 2.0;
    }


    public fn center_y(self) = float32 {
        return self.y + self.h / 2.0;
    }
}

struct Image {
    public data: uint8*,
    public w: int32,
    public h: int32,
    public mipmaps: int32,
    public format: int32,
}

struct Texture {
    public id: uint32,
    public width: int32,
    public height: int32,
    public mipmaps: int32,
    public format: int32,
}



extern fn InitWindow(w: int32, h: int32, title: uint8*);
extern fn CloseWindow();
extern fn WindowShouldClose() = bool;
extern fn SetTargetFPS(fps: int32);
extern fn BeginDrawing();
extern fn EndDrawing();

extern fn DrawText(str: uint8*, x: int32, y: int32, fontsize: int32, color: Color);

extern fn ClearBackground(color: Color);

extern fn GetMouseX() = int32;
extern fn GetMouseY() = int32;
extern fn DrawCircle(cx: int32, cy: int32, rad: float32, c: int32);
extern fn DrawCirc(cx: int32, cy: int32, rad: float32, c: Color) {
    DrawCircle(cx, cy, rad, cToInt(c));
}

fn GetMousePosition() = FVec2 {
    return FVec2(GetMouseX() as float32, GetMouseY() as float32);
}

//extern fn DrawRectangleRec(r: Rect, c: Color);

extern fn DrawRectangle(x: int32, y: int32, w: int32, h: int32, c: int32);

fn cToInt(c: Color) = int32 {
    let r = c.r as int32;
    let g = c.g as int32;
    let b = c.b as int32;
    let a = c.a as int32;

    return (r << 24) |
            (g << 16) |
            (b << 8) |
            a;
}

fn DrawRectangleRec(r: Rect, c: Color) {

    DrawRectangle(r.x as int32, r.y as int32, r.w as int32, r.h as int32, cToInt(c));
}