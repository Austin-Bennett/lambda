LABEL fib
PUSH BOTTOM
STORE BOTTOM, STACK
STORE RET, NUM(1)

CMP [BOTTOM-3], NUM(2)
JUMPL early_exit

PUSH [BOTTOM-3]
SUB [BOTTOM+0], NUM(1)
CALL fib
POPN 1
PUSH RET
PUSH [BOTTOM-3]
SUB [BOTTOM+1], NUM(2)
CALL fib
ADD RET, [BOTTOM+0]

POPN 2

LABEL early_exit
POP BOTTOM
RETURN


LABEL main
PUSH NUM(30)
CALL fib
POPN POINTER(1)
RETURN